import { Priority, TicketStatus, type Ticket } from "@prisma/client";

const SLA_HOURS: Record<Priority, number> = {
  CRITICAL: 24,
  HIGH: 48,
  MEDIUM: 72,
  LOW: 120
};

export function calculateDueDate(priority: Priority, from = new Date()) {
  const due = new Date(from);
  due.setHours(due.getHours() + SLA_HOURS[priority]);
  return due;
}

export function isSlaBreached(ticket: Pick<Ticket, "dueDate" | "status">) {
  if (!ticket.dueDate) return false;
  if ([TicketStatus.RESOLVED, TicketStatus.CLOSED].includes(ticket.status)) return false;
  return new Date() > ticket.dueDate;
}
EOF
