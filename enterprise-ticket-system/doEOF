import { Role, type Ticket } from "@prisma/client";

export type AuthUser = {
  id: string;
  name: string;
  email: string;
  role: Role;
};

export const isManagerOrAdmin = (role: Role) => role === Role.MANAGER || role === Role.ADMIN;
export const canManageUsers = (role: Role) => role === Role.ADMIN;
export const canViewAllTickets = (role: Role) => role === Role.MANAGER || role === Role.ADMIN;
export const canAssignTickets = (role: Role) => role === Role.MANAGER || role === Role.ADMIN;
export const canChangeTicketStatus = (role: Role) => role === Role.AGENT || role === Role.MANAGER || role === Role.ADMIN;
export const canViewAuditLogs = (role: Role) => role === Role.MANAGER || role === Role.ADMIN;

export function canAccessTicket(user: AuthUser, ticket: Pick<Ticket, "createdById" | "assignedToId">) {
  if (canViewAllTickets(user.role)) return true;
  if (user.role === Role.AGENT) return ticket.assignedToId === user.id;
  return ticket.createdById === user.id;
}
