generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model DashboardMetric {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  label     String
  value     String
  change    String
  helper    String
  icon      String
  accent    String
  sortOrder Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("dashboard_metrics")
}

model DashboardTicket {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  code      String   @unique
  title     String
  requester String
  company   String
  priority  String
  status    String
  owner     String
  sla       String
  sortOrder Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("dashboard_tickets")
}

model WorkflowStage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  label     String
  value     Int
  color     String
  sortOrder Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("dashboard_workflow_stages")
}

model SupportTeam {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  load      String
  members   Int
  color     String
  sortOrder Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("dashboard_teams")
}